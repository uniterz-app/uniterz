// Firebase Storage セキュリティルール（Web / ネイティブの client SDK アップロードと整合）
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /** Firestore の isAdmin と同じ（Custom Claim `admin` のみ） */
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    /** ラスタ画像のみ（SVG / HTML 等の公開ホスティングを防ぐ） */
    function isRasterImage() {
      return request.resource.contentType.matches('image/(png|jpe?g|webp|gif|heic|heif)');
    }

    function isOwnerImageUpload(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && isRasterImage();
    }

    // プロフィール画像 — Web `settings/profile` / ネイティブ `ProfileHomeScreen`
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwnerImageUpload(userId);
    }

    // お問い合わせ添付 — ContactForm
    match /contact_screenshots/{userId}/{allPaths=**} {
      allow read: if false;
      allow write: if isOwnerImageUpload(userId);
    }

    // コミュニティヘッダー — CreateGroupModal
    match /community_headers/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwnerImageUpload(userId);
    }

    // 商品交換の商品スクショ — RedemptionApply
    match /redemption_products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwnerImageUpload(userId);
    }

    // お知らせ画像 — app/admin/announcements（管理者のみクライアントからアップロード）
    match /announcements/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 12 * 1024 * 1024;
    }

    // 明示ルールに無いパスはデフォルトで拒否（catch-all の allow:false は一部クライアントで競合しうるため置かない）
  }
}
