// Firestore Security Rules（アプリの参照元と整合）
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- 管理者（app/admin/* ・ games/teams 手動投入・お知らせ編集 等）
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "S6r5KyS9XcXds3Pm7koLzzELrvs2";
    }

    /** WC knockout bracket — sync with lib/wc/wc-knockout-config submissionClosesAtIso (M73 kickoff). */
    function wcBracketSubmissionOpenForSeason(season) {
      return season != "2025-26"
        || request.time < timestamp.date(2026, 6, 28) + duration.time(19, 0, 0, 0);
    }

    /** Playoff bracket submission deadline (request.time is UTC). 2026-04-19 02:00 JST = 2026-04-18 17:00 UTC. Sync with lib/playoff-bracket-config submissionClosesAtIso. */
    function playoffBracketSubmissionOpenForSeason(season) {
      return season != "2026"
        || request.time < timestamp.date(2026, 4, 18) + duration.time(17, 0, 0, 0);
    }

    /**
     * 表示名・bio からギャンブル関連語を拒否（Web API `lib/profile/profileGamblingTerms.ts` と同趣旨）。
     * 直接 Firestore を書くクライアント対策。英語は単語境界。
     */
    function profileTextGamblingFree(s) {
      return s is string
        && !(s.matches('.*ベット.*')
            || s.matches('.*ベッド.*')
            || s.matches('.*ベッティング.*')
            || s.matches('.*賭け.*')
            || s.matches('.*賭博.*')
            || s.matches('.*ギャンブル.*')
            || s.matches('(?i).*\\bbet\\b.*')
            || s.matches('(?i).*\\bbetting\\b.*')
            || s.matches('(?i).*\\bbets\\b.*')
            || s.matches('(?i).*\\bbetted\\b.*')
            || s.matches('(?i).*\\bbettor\\b.*'));
    }

    function isValidNotificationPrefs(p) {
      return p is map
        && (!('gameStart' in p) || p.gameStart is bool)
        && (!('gameFinal' in p) || p.gameFinal is bool)
        && (!('rankingUpdated' in p) || p.rankingUpdated is bool)
        && p.keys().hasOnly(['gameStart', 'gameFinal', 'rankingUpdated']);
    }

    // ========================================================================
    // users
    // 参照: AuthProvider, SignupForm, OnboardingForm, Profile 設定, useProfile(handle),
    //       useUserLanguage, ContactForm, EventGate, ensureSlug 連携,
    //       users/{uid}/reads/*（お知らせ既読）, users/{uid}/groups/*（コミュAPIミラー）,
    //       users/{uid}/marks/*（MARK リスト）,
    //       users/{uid}/markedBy/*（被マーク）
    // ========================================================================
      // stripeCustomerIndex / stripeSubscriptionIndex — Admin のみ
    match /stripeCustomerIndex/{customerId} {
      allow read, write: if false;
    }
    match /stripeSubscriptionIndex/{subscriptionId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !('plan' in request.resource.data)
        && !('planType' in request.resource.data)
        && !('proUntil' in request.resource.data)
        && !('nextPlanType' in request.resource.data)
        && !('cancelAtPeriodEnd' in request.resource.data)
        && !('billingProvider' in request.resource.data)
        && !('unitBalance' in request.resource.data)
        && !('unitReserved' in request.resource.data)
        && !('stripeCustomerId' in request.resource.data)
        && !('stripeSubscriptionId' in request.resource.data)
        && !('googlePurchaseToken' in request.resource.data)
        && !('appleOriginalTransactionId' in request.resource.data)
        && !('proSkinUnlockedIds' in request.resource.data)
        && !('planProBgVariant' in request.resource.data)
        && !('proSkinProgress' in request.resource.data)
        && !('proSkinRankEarnedIds' in request.resource.data)
        && !('proSkinUnlockNoticeIds' in request.resource.data)
        && !('proSkinUnlockSeason' in request.resource.data)
        && !('proSkinHeldIds' in request.resource.data)
        && !('inviteCode' in request.resource.data)
        && !('referredByUid' in request.resource.data)
        && !('referralInviteCode' in request.resource.data)
        && !('referralBoundAt' in request.resource.data)
        && !('referralStats' in request.resource.data)
        && !('referralSettledAt' in request.resource.data)
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50
                && profileTextGamblingFree(request.resource.data.displayName)))
        && (!('bio' in request.resource.data)
            || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 500
                && profileTextGamblingFree(request.resource.data.bio)));

      allow update: if request.auth != null
        && request.auth.uid == userId
        && (!('handle' in resource.data) || !('handle' in request.resource.data)
            || request.resource.data.handle == resource.data.handle)
        && (!('username' in resource.data) || !('username' in request.resource.data)
            || request.resource.data.username == resource.data.username)
        && (!('slug' in resource.data) || !('slug' in request.resource.data)
            || request.resource.data.slug == resource.data.slug)
        && (!('counts' in request.resource.data)
            || request.resource.data.counts == resource.data.counts)
        // Pro / 課金 / Unit / 招待 / スキン解放は Admin・Functions のみ
        // plan 等は「既存と同じ値の維持」のみ可。新規追加・変更は不可。
        && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data)
            || request.resource.data.createdAt == resource.data.createdAt)
        && (!('unitBalance' in request.resource.data)
            || (('unitBalance' in resource.data)
                && request.resource.data.unitBalance == resource.data.unitBalance))
        && (!('unitReserved' in request.resource.data)
            || (('unitReserved' in resource.data)
                && request.resource.data.unitReserved == resource.data.unitReserved))
        && (!('stripeCustomerId' in request.resource.data)
            || (('stripeCustomerId' in resource.data)
                && request.resource.data.stripeCustomerId == resource.data.stripeCustomerId))
        && (!('stripeSubscriptionId' in request.resource.data)
            || (('stripeSubscriptionId' in resource.data)
                && request.resource.data.stripeSubscriptionId == resource.data.stripeSubscriptionId))
        && (!('googlePurchaseToken' in request.resource.data)
            || (('googlePurchaseToken' in resource.data)
                && request.resource.data.googlePurchaseToken == resource.data.googlePurchaseToken))
        && (!('appleOriginalTransactionId' in request.resource.data)
            || (('appleOriginalTransactionId' in resource.data)
                && request.resource.data.appleOriginalTransactionId == resource.data.appleOriginalTransactionId))
        && (!('proSkinUnlockedIds' in request.resource.data)
            || (('proSkinUnlockedIds' in resource.data)
                && request.resource.data.proSkinUnlockedIds == resource.data.proSkinUnlockedIds))
        && (!('planProBgVariant' in request.resource.data)
            || (('planProBgVariant' in resource.data)
                && request.resource.data.planProBgVariant == resource.data.planProBgVariant))
        && (!('proSkinProgress' in request.resource.data)
            || (('proSkinProgress' in resource.data)
                && request.resource.data.proSkinProgress == resource.data.proSkinProgress))
        && (!('proSkinRankEarnedIds' in request.resource.data)
            || (('proSkinRankEarnedIds' in resource.data)
                && request.resource.data.proSkinRankEarnedIds == resource.data.proSkinRankEarnedIds))
        && (!('proSkinUnlockNoticeIds' in request.resource.data)
            || (('proSkinUnlockNoticeIds' in resource.data)
                && request.resource.data.proSkinUnlockNoticeIds == resource.data.proSkinUnlockNoticeIds))
        && (!('proSkinUnlockSeason' in request.resource.data)
            || (('proSkinUnlockSeason' in resource.data)
                && request.resource.data.proSkinUnlockSeason == resource.data.proSkinUnlockSeason))
        && (!('proSkinHeldIds' in request.resource.data)
            || (('proSkinHeldIds' in resource.data)
                && request.resource.data.proSkinHeldIds == resource.data.proSkinHeldIds))
        && (!('billingProvider' in request.resource.data)
            || (('billingProvider' in resource.data)
                && request.resource.data.billingProvider == resource.data.billingProvider))
        && (!('cancelAtPeriodEnd' in request.resource.data)
            || (('cancelAtPeriodEnd' in resource.data)
                && request.resource.data.cancelAtPeriodEnd == resource.data.cancelAtPeriodEnd))
        && (!('nextPlanType' in request.resource.data)
            || (('nextPlanType' in resource.data)
                && request.resource.data.nextPlanType == resource.data.nextPlanType))
        && (!('planType' in request.resource.data)
            || (('planType' in resource.data)
                && request.resource.data.planType == resource.data.planType))
        && (!('plan' in request.resource.data)
            || (('plan' in resource.data)
                && request.resource.data.plan == resource.data.plan))
        && (!('proUntil' in request.resource.data)
            || (('proUntil' in resource.data)
                && request.resource.data.proUntil == resource.data.proUntil))
        && (!('inviteCode' in request.resource.data)
            || (('inviteCode' in resource.data)
                && request.resource.data.inviteCode == resource.data.inviteCode))
        && (!('referredByUid' in request.resource.data)
            || (('referredByUid' in resource.data)
                && request.resource.data.referredByUid == resource.data.referredByUid))
        && (!('referralInviteCode' in request.resource.data)
            || (('referralInviteCode' in resource.data)
                && request.resource.data.referralInviteCode == resource.data.referralInviteCode))
        && (!('referralBoundAt' in request.resource.data)
            || (('referralBoundAt' in resource.data)
                && request.resource.data.referralBoundAt == resource.data.referralBoundAt))
        && (!('referralStats' in request.resource.data)
            || (('referralStats' in resource.data)
                && request.resource.data.referralStats == resource.data.referralStats))
        && (!('referralSettledAt' in request.resource.data)
            || (('referralSettledAt' in resource.data)
                && request.resource.data.referralSettledAt == resource.data.referralSettledAt))
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50
                && profileTextGamblingFree(request.resource.data.displayName)))
        && (!('bio' in request.resource.data)
            || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 500
                && profileTextGamblingFree(request.resource.data.bio)))
        && (!('photoURL' in request.resource.data)
            || request.resource.data.photoURL == null
            || request.resource.data.photoURL is string)
        && (!('language' in request.resource.data)
            || request.resource.data.language == 'ja'
            || request.resource.data.language == 'en')
        && (!('notificationPrefs' in request.resource.data)
            || isValidNotificationPrefs(request.resource.data.notificationPrefs));

      allow delete: if request.auth != null && request.auth.uid == userId;

      // 課金シークレット — 本人 read のみ、クライアント write 不可
      match /secure/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      // Unit 獲得演出キュー — Functions が書き、API(Admin) が既読。クライアント直書き不可
      match /pending_unit_earns/{earnId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /reads/{announcementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /groups/{groupId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      // Native プッシュトークン — クライアント直接書き込み可（API 経由推奨）
      match /pushTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // MARK リスト — 本人のみ。フォロワー数は持たない
      match /marks/{targetUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && targetUid != userId
          && request.resource.data.targetUid == targetUid
          && request.resource.data.handle is string
          && request.resource.data.displayName is string
          && (!('photoURL' in request.resource.data)
              || request.resource.data.photoURL == null
              || request.resource.data.photoURL is string);
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // 被マーク — 誰にマークされたかは本人だけ読める。人数だけ UI に出す
      match /markedBy/{fromUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == fromUid
          && fromUid != userId;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == fromUid;
      }

      // admin/badges から users/{uid}/badges/{id} へ付与
      match /badges/{badgeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // プロフィール閲覧イベント・集計 — API（Admin SDK）からのみ利用
    match /profile_views/{viewId} {
      allow read, write: if false;
    }

    match /profile_view_counts/{userId} {
      allow read, write: if false;
    }

    // ========================================================================
    // slugs — ensureUserSlug（@handle 用）
    // ========================================================================
    match /slugs/{slugId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/slugs/$(slugId));
      allow update, delete: if false;
    }

    // ========================================================================
    // posts — 一覧・予想カード表示。本文の作成/更新/削除は API（Admin SDK）
    // likes/saves: PredictionPostCardV2
    // ========================================================================
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /likes/{likeUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == likeUid;
        allow delete: if request.auth != null && request.auth.uid == likeUid;
      }

      match /saves/{saveUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == saveUid;
        allow delete: if request.auth != null && request.auth.uid == saveUid;
      }
    }

    // ========================================================================
    // games / teams — ScheduleList, useGameDays, predict 画面, 結果UI 等（読取）
    // 管理画面 games-import / team-init は isAdmin
    // ========================================================================
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // お知らせ — 一覧・詳細は公開読取。管理画面から isAdmin が編集
    // ========================================================================
    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // お問い合わせ — POST /api/contact（Admin）のみ。クライアント直書き禁止
    // ========================================================================
    match /contacts/{contactId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ========================================================================
    // バッジ — useMasterBadges / useUserBadges
    // 付与は Admin / Functions のみ
    // ========================================================================
    match /master_badges/{bid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_badges/{uid} {
      match /badges/{badgeId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ========================================================================
    // 統計 v2 — GamesPage, ProAnalysis, useUserStatsDailyTrend（プロフィール日次）, 月次リスト等
    // ========================================================================
    match /user_stats_v2/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /user_stats_v2_daily/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /user_stats_v2_monthly/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /monthly_global_stats_v2/{month} {
      allow read: if true;
      allow write: if false;
    }


    // cumulative_stats — Functions が集計。プロフィール / ランキング表示用に公開読取
    match /cumulative_stats/{uid} {
      allow read: if true;
      allow write: if false;

      match /rankSnapshotHistory/{dateKey} {
        allow read: if true;
        allow write: if false;
      }

      match /profileCharts/{seasonKey} {
        allow read: if true;
        allow write: if false;
      }
    }

    // user_career — CAREER 通算正本。Functions / Admin API のみ書込。公開読取。
    match /user_career/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // user_reports — 週次/月次レポート。Functions のみ書込。
    // 本人は常に読める。他人は双方 Pro のときだけ（プロフィール Report タブと同じ）。
    function userPlanIsPro(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.plan == "pro";
    }
    match /user_reports/{reportId} {
      allow read: if request.auth != null
        && resource.data.uid is string
        && (
          resource.data.uid == request.auth.uid
          || (userPlanIsPro(request.auth.uid) && userPlanIsPro(resource.data.uid))
        );
      allow write: if false;
    }

    // ========================================================================
    // プレーオフ — lib/playoff-*, PlayoffBracketMarket, usePlayoffOfficialResults
    // ========================================================================
    // シーズンアワード予想 — Admin API のみ書込（/api/me/season-awards）
    match /seasonAwardsPredictions/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /seasonStandingsPredictions/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================================================
    // referralRelations — 招待関係（inviteeUid が docId）
    // 作成・進捗・付与は API（Admin SDK）のみ。当事者は read 可。
    // ========================================================================
    match /referralRelations/{inviteeUid} {
      allow read: if request.auth != null
        && (request.auth.uid == inviteeUid
            || request.auth.uid == resource.data.referrerUid);
      allow create, update, delete: if false;
    }

    // 招待コード一意マップ — Admin のみ
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Unit 台帳 — Admin のみ
    match /unit_ledger/{ledgerId} {
      allow read, write: if false;
    }

    // 商品交換申請 — 作成・更新は API（Admin SDK）のみ。本人は read 可。
    match /unit_redemptions/{redemptionId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow create, update, delete: if false;
    }

    match /playoffBracketMarket/{season} {
      allow read: if true;
      allow write: if false;
    }

    match /playoffResults/{season} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /playoffBrackets/{docId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.season is string
        && request.resource.data.bracket is map
        && docId == request.resource.data.season + '_' + request.auth.uid
        && playoffBracketSubmissionOpenForSeason(request.resource.data.season);

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && docId == resource.data.season + '_' + request.auth.uid
        && playoffBracketSubmissionOpenForSeason(resource.data.season);

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && docId == resource.data.season + '_' + request.auth.uid
        && playoffBracketSubmissionOpenForSeason(resource.data.season);
    }

    // Chunked rescore queue — Cloud Functions のみ（Admin SDK）
    match /playoffBracketRescoreTasks/{taskId} {
      allow read, write: if false;
    }

    // ========================================================================
    // WC ノックアウトブラケット予想 — lib/wc/wc-bracket-firestore.ts
    // ========================================================================
    match /wcBracketResults/{season} {
      allow read: if true;
      allow write: if false;
    }

    match /wcKnockoutAdvancement/{season} {
      allow read: if true;
      allow write: if false;
    }

    match /wcBrackets/{docId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.season is string
        && request.resource.data.bracket is map
        && request.resource.data.isSubmitted == true
        && docId == request.resource.data.season + '_' + request.auth.uid
        && wcBracketSubmissionOpenForSeason(request.resource.data.season);

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && docId == resource.data.season + '_' + request.auth.uid
        && wcBracketSubmissionOpenForSeason(resource.data.season)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.season == resource.data.season
        && request.resource.data.isSubmitted == true
        && request.resource.data.bracket is map;

      allow delete: if false;
    }

    match /wcBracketRescoreTasks/{taskId} {
      allow read, write: if false;
    }

    // ========================================================================
    // コミュニティ — app/api/communities/* のみ（Admin SDK）。クライアント直叩き禁止
    // ========================================================================
    match /groups/{groupId} {
      allow read, write: if false;

      match /members/{memberId} {
        allow read, write: if false;
      }
    }

    // ========================================================================
    // analytics — functions/src/analytics/_core.ts → analytics/daily/stats/{dateKey}
    // ========================================================================
    match /analytics/{analyticsDocId} {
      match /stats/{statId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ========================================================================
    // イベントログ（B1/J1/NBA）— 認証必須・サイズ制限（スパム・コスト増幅対策）
    // ========================================================================
    match /events_game/{eventId} {
      allow create: if
        request.auth != null
        && request.resource.data.keys().hasOnly([
          "type", "gameId", "league", "ts", "uid"
        ])
        && request.resource.data.type in [
          "click", "view", "predict",
          "click_card", "open_predictions", "open_predict"
        ]
        && request.resource.data.gameId is string
        && request.resource.data.gameId.size() > 0
        && request.resource.data.gameId.size() <= 128
        && request.resource.data.league in ["B1","J1","NBA"]
        && (!('ts' in request.resource.data) || request.resource.data.ts is number)
        && (!('uid' in request.resource.data)
          || request.resource.data.uid == request.auth.uid);
      allow read, update, delete: if false;
    }

    match /events_profile/{eventId} {
      allow create: if
        request.auth != null
        && request.resource.data.keys().hasOnly([
          "type", "profileId", "ts", "uid"
        ])
        && request.resource.data.type in ["profile_view","follow_click"]
        && request.resource.data.profileId is string
        && request.resource.data.profileId.size() > 0
        && request.resource.data.profileId.size() <= 128
        && (!('ts' in request.resource.data) || request.resource.data.ts is number)
        && (!('uid' in request.resource.data)
          || request.resource.data.uid == request.auth.uid);
      allow read, update, delete: if false;
    }
  }
}
