// Firestore Security Rules（アプリの参照元と整合）
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- 管理者（Custom Claim `admin` のみ）
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    /**
     * Playoff bracket submission deadline (request.time is UTC). 未登録シーズンは拒否。
     * 新シーズンは lib/playoff-bracket-config の submissionClosesAtIso と同時にここへ追加する。
     * 2026-04-19 02:00 JST = 2026-04-18 17:00 UTC.
     */
    function playoffBracketSubmissionOpenForSeason(season) {
      return season == "2026"
        && request.time < timestamp.date(2026, 4, 18) + duration.time(17, 0, 0, 0);
    }

    /** ensureUserSlug（lib/ensureSlug.ts genSlug）と同じ 8 文字 */
    function isGeneratedSlug(s) {
      return s is string && s.matches('^[a-hjkmnp-z0-9]{8}$');
    }

    /** handle / username / slug は本人が確保した slugs/{id} と一致する値のみ */
    function ownsSlug(s) {
      return isGeneratedSlug(s)
        && existsAfter(/databases/$(database)/documents/slugs/$(s))
        && getAfter(/databases/$(database)/documents/slugs/$(s)).data.uid == request.auth.uid;
    }

    function identityFieldOk(field) {
      return !(field in request.resource.data)
        || (field in resource.data && request.resource.data[field] == resource.data[field])
        || ownsSlug(request.resource.data[field]);
    }

    function identityFieldOkOnCreate(field) {
      return !(field in request.resource.data) || ownsSlug(request.resource.data[field]);
    }

    /** 他人の予想は決着後または試合開始後のみ（本人は常に） */
    function postReadable() {
      return (request.auth != null && resource.data.authorUid == request.auth.uid)
        || resource.data.settledAt != null
        || resource.data.startAt <= request.time;
    }

    /**
     * 表示名・bio からギャンブル関連語を拒否（Web API `lib/profile/profileGamblingTerms.ts` と同趣旨）。
     * 直接 Firestore を書くクライアント対策。英語は単語境界。
     */
    function profileTextGamblingFree(s) {
      return s is string
        && !(s.matches('.*ベット.*')
            || s.matches('.*ベッド.*')
            || s.matches('.*ベッティング.*')
            || s.matches('.*賭け.*')
            || s.matches('.*賭博.*')
            || s.matches('.*ギャンブル.*')
            || s.matches('(?i).*\\bbet\\b.*')
            || s.matches('(?i).*\\bbetting\\b.*')
            || s.matches('(?i).*\\bbets\\b.*')
            || s.matches('(?i).*\\bbetted\\b.*')
            || s.matches('(?i).*\\bbettor\\b.*'));
    }

    function isValidNotificationPrefs(p) {
      return p is map
        && p.keys().hasOnly([
          'gameStart', 'gameFinal', 'rankingUpdated',
          'injuryStatus', 'starterChange', 'predictionDeadline',
          'pregameDigest', 'proInsightUpdate', 'monthlyReport',
          'predictionDeadlineMinutes'
        ])
        && (!('gameStart' in p) || p.gameStart is bool)
        && (!('gameFinal' in p) || p.gameFinal is bool)
        && (!('rankingUpdated' in p) || p.rankingUpdated is bool)
        && (!('injuryStatus' in p) || p.injuryStatus is bool)
        && (!('starterChange' in p) || p.starterChange is bool)
        && (!('predictionDeadline' in p) || p.predictionDeadline is bool)
        && (!('pregameDigest' in p) || p.pregameDigest is bool)
        && (!('proInsightUpdate' in p) || p.proInsightUpdate is bool)
        && (!('monthlyReport' in p) || p.monthlyReport is bool)
        && (!('predictionDeadlineMinutes' in p)
            || p.predictionDeadlineMinutes == 10
            || p.predictionDeadlineMinutes == 30
            || p.predictionDeadlineMinutes == 60);
    }

    function isSupportedLanguage(v) {
      return v == 'ja' || v == 'en' || v == 'zh' || v == 'ko'
        || v == 'es' || v == 'de' || v == 'fr' || v == 'ar' || v == 'pt';
    }

    // ========================================================================
    // users
    // 参照: AuthProvider, SignupForm, OnboardingForm, Profile 設定, useProfile(handle),
    //       useUserLanguage, ContactForm, EventGate, ensureSlug 連携,
    //       users/{uid}/reads/*（お知らせ既読）, users/{uid}/groups/*（コミュAPIミラー）,
    //       users/{uid}/marks/*（MARK リスト）,
    //       users/{uid}/markedBy/*（被マーク）
    // ========================================================================
      // stripeCustomerIndex / stripeSubscriptionIndex — Admin のみ
    match /stripeCustomerIndex/{customerId} {
      allow read, write: if false;
    }
    match /stripeSubscriptionIndex/{subscriptionId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // 公開プロフィール。ルートには PUBLIC / PRODUCT フィールドだけを置く。
      // sensitive は secure/ / private/ へ。棚卸し: lib/security/publicUserDocumentFields.ts
      // フィールド単位の read 制限はできないので、scrub 後のルートが安全である前提。
      // 一覧（列挙）は不可。handle / slug → uid は slugs/{key} で引く
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'photoURL', 'avatarUrl', 'photoCropY',
          'createdAt', 'updatedAt', 'counts',
          'handle', 'username', 'slug',
          'language', 'locale', 'timeZone', 'countryCode', 'preferredLeague',
          'onboardingCompletedAt',
          'favoriteNbaTeamId', 'favoriteNbaTeamFanSinceSeason', 'favoriteNbaPlayers'
        ])
        && !('plan' in request.resource.data)
        && !('planType' in request.resource.data)
        && !('proUntil' in request.resource.data)
        && !('nextPlanType' in request.resource.data)
        && !('cancelAtPeriodEnd' in request.resource.data)
        && !('billingProvider' in request.resource.data)
        && !('unitBalance' in request.resource.data)
        && !('unitReserved' in request.resource.data)
        && !('profileViewCount' in request.resource.data)
        && !('stripeCustomerId' in request.resource.data)
        && !('stripeSubscriptionId' in request.resource.data)
        && !('googlePurchaseToken' in request.resource.data)
        && !('appleOriginalTransactionId' in request.resource.data)
        && !('proSkinUnlockedIds' in request.resource.data)
        && !('planProBgVariant' in request.resource.data)
        && !('proSkinProgress' in request.resource.data)
        && !('proSkinRankEarnedIds' in request.resource.data)
        && !('proSkinUnlockNoticeIds' in request.resource.data)
        && !('proSkinUnlockSeason' in request.resource.data)
        && !('proSkinHeldIds' in request.resource.data)
        && !('inviteCode' in request.resource.data)
        && !('referredByUid' in request.resource.data)
        && !('referralInviteCode' in request.resource.data)
        && !('referralBoundAt' in request.resource.data)
        && !('referralStats' in request.resource.data)
        && !('referralSettledAt' in request.resource.data)
        && !('email' in request.resource.data)
        && !('notificationPrefs' in request.resource.data)
        && (!('createdAt' in request.resource.data)
            || request.resource.data.createdAt == request.time)
        && (!('counts' in request.resource.data)
            || request.resource.data.counts == { 'posts': 0 })
        && identityFieldOkOnCreate('handle')
        && identityFieldOkOnCreate('username')
        && identityFieldOkOnCreate('slug')
        && (!('language' in request.resource.data)
            || isSupportedLanguage(request.resource.data.language))
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50
                && profileTextGamblingFree(request.resource.data.displayName)))
        && (!('bio' in request.resource.data)
            || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 500
                && profileTextGamblingFree(request.resource.data.bio)));

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'bio', 'photoURL', 'avatarUrl', 'photoCropY',
          'updatedAt',
          'handle', 'username', 'slug',
          'language', 'locale', 'timeZone', 'countryCode', 'preferredLeague',
          'onboardingCompletedAt',
          'favoriteNbaTeamId', 'favoriteNbaTeamFanSinceSeason', 'favoriteNbaPlayers'
        ])
        && (!('handle' in resource.data) || !('handle' in request.resource.data)
            || request.resource.data.handle == resource.data.handle)
        && (!('username' in resource.data) || !('username' in request.resource.data)
            || request.resource.data.username == resource.data.username)
        && (!('slug' in resource.data) || !('slug' in request.resource.data)
            || request.resource.data.slug == resource.data.slug)
        && identityFieldOk('handle')
        && identityFieldOk('username')
        && identityFieldOk('slug')
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50
                && profileTextGamblingFree(request.resource.data.displayName)))
        && (!('bio' in request.resource.data)
            || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 500
                && profileTextGamblingFree(request.resource.data.bio)))
        && (!('photoURL' in request.resource.data)
            || request.resource.data.photoURL == null
            || request.resource.data.photoURL is string)
        && (!('language' in request.resource.data)
            || isSupportedLanguage(request.resource.data.language));

      // 退会は DELETE /api/me/account（墓標化）のみ
      allow delete: if false;

      // 課金・招待コード等 — 本人 read のみ、クライアント write 不可
      match /secure/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      // 通知設定など — 本人のみ read/write（公開ルートから外した）
      match /private/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && (docId != 'notificationPrefs'
              || (request.resource.data.keys().hasOnly(['prefs', 'updatedAt'])
                  && isValidNotificationPrefs(request.resource.data.prefs)));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Unit 獲得演出キュー — Functions が書き、API(Admin) が既読。クライアント直書き不可
      match /pending_unit_earns/{earnId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /reads/{announcementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /groups/{groupId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      // Native プッシュトークン — 書き込みは POST/DELETE /api/me/push-token のみ
      match /pushTokens/{tokenId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // MARK リスト — 本人のみ。フォロワー数は持たない
      match /marks/{targetUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && targetUid != userId
          && request.resource.data.targetUid == targetUid
          && request.resource.data.handle is string
          && request.resource.data.displayName is string
          && (!('photoURL' in request.resource.data)
              || request.resource.data.photoURL == null
              || request.resource.data.photoURL is string);
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // 被マーク — 誰にマークされたかは本人だけ読める。人数だけ UI に出す
      match /markedBy/{fromUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == fromUid
          && fromUid != userId
          && request.resource.data.keys().hasOnly(['fromUid', 'createdAtMs'])
          && request.resource.data.fromUid == fromUid
          && request.resource.data.createdAtMs is number;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == fromUid;
      }

      // admin/badges から users/{uid}/badges/{id} へ付与
      match /badges/{badgeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // プロフィール閲覧イベント・集計 — API（Admin SDK）からのみ利用
    match /profile_views/{viewId} {
      allow read, write: if false;
    }

    match /profile_view_counts/{userId} {
      allow read, write: if false;
    }

    // ========================================================================
    // slugs — ensureUserSlug（@handle 用）
    // ========================================================================
    match /slugs/{slugId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && isGeneratedSlug(slugId)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/slugs/$(slugId));
      allow update, delete: if false;
    }

    // ========================================================================
    // posts — 一覧・予想カード表示。本文の作成/更新/削除は API（Admin SDK）
    // likes/saves: PredictionPostCardV2
    // ========================================================================
    match /posts/{postId} {
      allow read: if postReadable();
      allow create, update, delete: if false;

      // いいね / 保存は API（Admin SDK）経由。本人の行だけ読める
      match /likes/{likeUid} {
        allow read: if request.auth != null && request.auth.uid == likeUid;
        allow write: if false;
      }

      match /saves/{saveUid} {
        allow read: if request.auth != null && request.auth.uid == saveUid;
        allow write: if false;
      }
    }

    // ========================================================================
    // games / teams — ScheduleList, useGameDays, predict 画面, 結果UI 等（読取）
    // 管理画面 games-import / team-init は isAdmin
    // ========================================================================
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // お知らせ — 一覧・詳細は公開読取。管理画面から isAdmin が編集
    // ========================================================================
    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // お問い合わせ — POST /api/contact（Admin）のみ。クライアント直書き禁止
    // ========================================================================
    match /contacts/{contactId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ========================================================================
    // バッジ — useMasterBadges / useUserBadges
    // 付与は Admin / Functions のみ
    // ========================================================================
    match /master_badges/{bid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_badges/{uid} {
      match /badges/{badgeId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ========================================================================
    // 統計 v2 — GamesPage, ProAnalysis, useUserStatsDailyTrend（プロフィール日次）, 月次リスト等
    // ========================================================================
    match /user_stats_v2/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // docId は {uid}_{date}。他人のプロフィール日次チャートを描くため
    // 認証済みなら他人の doc も読める。
    //
    // 縮小できない理由: NBA overview のチャートは前シーズン混入を避けるため
    // Firestore を厳密に読む経路（apps/native profileApi.fetchNbaOverviewDailyTrendStrict、
    // Web useUserStatsDailyTrend）に依存している。
    // 自分の uid のみに絞るには先に /api/profile/user-stats?parts=trend を
    // シーズン境界まで正確にする必要がある。
    match /user_stats_v2_daily/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 月次は本人のみ。クライアントの他人読みは廃止済み（表示は /api/profile/user-stats 経由）
    match /user_stats_v2_monthly/{docId} {
      allow read: if request.auth != null
        && resource.data.uid is string
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /monthly_global_stats_v2/{month} {
      allow read: if true;
      allow write: if false;
    }


    // cumulative_stats — Functions が集計。プロフィール / ランキング表示用に公開読取
    match /cumulative_stats/{uid} {
      allow read: if true;
      allow write: if false;

      match /rankSnapshotHistory/{dateKey} {
        allow read: if true;
        allow write: if false;
      }

      match /profileCharts/{seasonKey} {
        allow read: if true;
        allow write: if false;
      }
    }

    // user_career — CAREER 通算正本。Functions / Admin API のみ書込。公開読取。
    match /user_career/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // user_reports — 週次/月次レポート。Functions のみ書込。
    // 本人は常に読める。他人は双方 Pro のときだけ（プロフィール Report タブと同じ）。
    function userPlanIsPro(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.plan == "pro";
    }
    match /user_reports/{reportId} {
      allow read: if request.auth != null
        && resource.data.uid is string
        && (
          resource.data.uid == request.auth.uid
          || (userPlanIsPro(request.auth.uid) && userPlanIsPro(resource.data.uid))
        );
      allow write: if false;
    }

    // ========================================================================
    // プレーオフ — lib/playoff-*, PlayoffBracketMarket, usePlayoffOfficialResults
    // ========================================================================
    // シーズンアワード予想 — Admin API のみ書込（/api/me/season-awards）
    match /seasonAwardsPredictions/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /seasonStandingsPredictions/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================================================
    // referralRelations — 招待関係（inviteeUid が docId）
    // 作成・進捗・付与は API（Admin SDK）のみ。当事者は read 可。
    // ========================================================================
    match /referralRelations/{inviteeUid} {
      allow read: if request.auth != null
        && (request.auth.uid == inviteeUid
            || request.auth.uid == resource.data.referrerUid);
      allow create, update, delete: if false;
    }

    // 招待コード一意マップ — Admin のみ
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Unit 台帳 — Admin のみ
    match /unit_ledger/{ledgerId} {
      allow read, write: if false;
    }

    // グループバトル — クライアント SDK 直読み書きなし（API / Functions の Admin SDK のみ）
    match /group_battles/{battleId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }
    match /group_battle_period_snapshots/{snapshotId} {
      allow read, write: if false;
    }

    // 商品交換申請 — 作成・更新は API（Admin SDK）のみ。本人は read 可。
    match /unit_redemptions/{redemptionId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.uid);
      allow create, update, delete: if false;
    }

    match /playoffBracketMarket/{season} {
      allow read: if true;
      allow write: if false;
    }

    match /playoffResults/{season} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /playoffBrackets/{docId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'uid', 'season', 'bracket', 'championPick', 'isSubmitted', 'submittedAt',
          'totalScore', 'winnerPoints', 'gamesPoints', 'alive', 'firstMissSeriesId'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.season is string
        && request.resource.data.bracket is map
        && request.resource.data.isSubmitted == true
        && request.resource.data.submittedAt == request.time
        && request.resource.data.totalScore == 0
        && request.resource.data.winnerPoints == 0
        && request.resource.data.gamesPoints == 0
        && request.resource.data.alive == true
        && request.resource.data.firstMissSeriesId == null
        && docId == request.resource.data.season + '_' + request.auth.uid
        && playoffBracketSubmissionOpenForSeason(request.resource.data.season);

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && docId == resource.data.season + '_' + request.auth.uid
        && playoffBracketSubmissionOpenForSeason(resource.data.season)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['bracket', 'championPick'])
        && request.resource.data.bracket is map;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && docId == resource.data.season + '_' + request.auth.uid
        && playoffBracketSubmissionOpenForSeason(resource.data.season);
    }

    // Chunked rescore queue — Cloud Functions のみ（Admin SDK）
    match /playoffBracketRescoreTasks/{taskId} {
      allow read, write: if false;
    }

    // ========================================================================
    // WC ノックアウトブラケット予想 — lib/wc/wc-bracket-firestore.ts
    // ========================================================================
    match /wcBracketResults/{season} {
      allow read: if true;
      allow write: if false;
    }

    match /wcKnockoutAdvancement/{season} {
      allow read: if true;
      allow write: if false;
    }

    // 2025-26 WC は締切済み・クライアント実装も撤去済み。読取のみ
    match /wcBrackets/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /wcBracketRescoreTasks/{taskId} {
      allow read, write: if false;
    }

    // ========================================================================
    // コミュニティ — app/api/communities/* のみ（Admin SDK）。クライアント直叩き禁止
    // ========================================================================
    match /groups/{groupId} {
      allow read, write: if false;

      match /members/{memberId} {
        allow read, write: if false;
      }
    }

    // ========================================================================
    // analytics — functions/src/analytics/_core.ts → analytics/daily/stats/{dateKey}
    // ========================================================================
    match /analytics/{analyticsDocId} {
      match /stats/{statId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ========================================================================
    // イベントログ（旧 B1/J1/NBA）— 書き込み元なし。再開するなら API 経由＋レート制限で
    // ========================================================================
    match /events_game/{eventId} {
      allow read, write: if false;
    }

    match /events_profile/{eventId} {
      allow read, write: if false;
    }

    // レート制限カウンタ — Admin SDK 専用。expiresAt に TTL ポリシーを張る
    match /rate_limits/{docId} {
      allow read, write: if false;
    }
  }
}
